{#- play button: plays the episode `p` in the persistent player (see assets/js/player.js) ~#}
{%- set file = asset(p.episode.file) -%}
{%- set image = asset(p.episode.image ?? site.podcast.image) -%}
{%- set episode = {
  key: file ~ '',
  src: file|url,
  title: p.title,
  url: url(p),
  artist: p.episode.author ?? site.podcast.author ?? site.title,
  image: image|url,
  imageSizes: image.width ~ 'x' ~ image.height,
  imageType: image.subtype,
  thumb: image|resize(96)|url,
  prev: p.prev|default(false) ? url(p.prev) : null,
  next: p.next|default(false) ? url(p.next) : null,
} -%}
<a href="{{ url(p) }}#autoplay" class="group inline-flex items-center gap-1 px-2 py-1 border border-slate-300 rounded-full text-primary hover:brightness-75 data-[state=ended]:text-slate-500" data-player-play{% if autoload|default(false) %} data-player-autoload{% endif %} data-state="play" data-episode="{{ episode|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-data-[state=pause]:hidden" viewbox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/></svg>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden group-data-[state=pause]:block" viewbox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
  <span class="uppercase" data-player-label>{% trans %}Play{% endtrans %}</span>
</a>
